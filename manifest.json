    for(let x=rear+0.3,i=0;x<front-0.4;x+=0.46,i++)box(0.3,0.05,0.005,i%2?M.tapeW:M.tapeR,x,FL+0.13,s*(TW/2+0.031),g);
    [[front-0.1,M.amber],[cx,M.amber],[rear+0.2,M.red]].forEach(([x,m])=>{box(0.09,0.05,0.03,m,x,FL+0.13,s*(TW/2+0.045),g);box(0.09,0.05,0.03,m,x,TOP-0.08,s*(TW/2+0.025),g);});
    box(0.03,H-0.24,TW/2-0.08,doorMat,rear-0.07,FL+H/2,s*(TW/4),g);
    for(let i=0;i<4;i++)box(0.05,0.08,0.18,M.alum,rear-0.1,FL+0.35+i*(H-0.6)/3,s*(TW/2-0.08),g);
  });
  box(len,0.04,TW+0.02,M.alum,cx,TOP+0.02,0,g);
  box(0.06,H+0.04,TW+0.06,M.alum,rear-0.03,FL+H/2,0,g);
  for(let x=rear+0.4;x<-2.1;x+=0.4)box(0.08,0.1,TW-0.1,M.frame,x,FL-0.05,0,g);
  /* upper coupler plate + kingpin */
  box(1.6,0.03,1.7,M.frame,0,FL-0.015,0,g);
  const kp=cyl(0.045,0.1,M.chrome,0,FL-0.08,0,null,g,16);
  cyl(0.06,0.025,M.chrome,0,FL-0.14,0,null,g,16);
  /* front: glad hands + light socket */
  box(0.04,0.18,0.12,M.lineR,front+0.02,1.58,-0.85,g);
  box(0.04,0.18,0.12,M.lineB,front+0.02,1.58,-0.62,g);
  cyl(0.06,0.06,M.black,front+0.03,1.76,0,'x',g,14);
  /* sliding tandem */
  const ax=[rear+2.0,rear+3.25];
  [0.48,-0.48].forEach(z=>box(4.2,0.25,0.12,M.frame,rear+2.65,FL-0.22,z,g));
  ax.forEach(x=>{
    cyl(0.065,TW-0.25,M.frame,x,WY,0,'z',g,12);
    [1,-1].forEach(s=>{wheelSet(g,x,s,'dual',sp);box(0.7,0.08,0.1,M.frame,x,0.75,s*0.48,g);});
  });
  [1,-1].forEach(s=>box(0.02,0.65,0.62,M.rubber,ax[0]-0.75,0.55,s*(TW/2-0.36),g));
  /* rear bumper + lights */
  const rx=rear-0.12,ry=FL+0.2;
  box(0.12,0.12,TW-0.2,M.frame,rx+0.05,0.55,0,g);
  [0.6,-0.6].forEach(z=>box(0.1,ry-0.55,0.1,M.frame,rx+0.12,(ry+0.55)/2,z,g));
  [1,-1].forEach(s=>[0.12,0.3].forEach(q=>cyl(0.07,0.04,M.red,rx-0.02,ry,s*(TW/2-q),'x',g,16)));
  /* landing gear: outer legs fixed, inner legs + feet move */
  const LX=-2.7, legs=new THREE.Group(); g.add(legs);
  [1,-1].forEach(s=>{
    box(0.16,FL-0.72,0.16,M.frame,LX,(FL+0.72)/2,s*0.85,g);
    box(0.12,0.7,0.12,M.alum,LX,0.35,s*0.85,legs);
    box(0.36,0.04,0.3,M.frame,LX,0.02,s*0.85,legs);
