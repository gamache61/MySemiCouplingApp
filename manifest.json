  const len=front-rear,H=TOP-FL,cx=rear+len/2;
  box(len,H,TW,M.trailer,cx,FL+H/2,0,g);
  for(let x=rear+0.6;x<front-0.3;x+=0.61)[1,-1].forEach(s=>box(0.06,H-0.12,0.012,postMat,x,FL+H/2,s*(TW/2+0.006),g));
  [1,-1].forEach(s=>{
    box(len,0.09,0.03,M.alum,cx,TOP-0.045,s*(TW/2+0.01),g);
