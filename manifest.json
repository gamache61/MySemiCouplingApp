<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0e1317">
<title>Coupling &amp; Uncoupling Trainer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap">
<style>
/* Layout: full-height app, 3D yard on the left with a dash overlay, instructor panel on the right; stacks on phones. Hi-vis amber on slate, same family as Chain-Up Trainer. */
:root{
  --bg:#0e1317; --panel:#161d23; --panel2:#1c252c; --line:#2a353e;
  --fg:#e9eef1; --muted:#97a5af; --amber:#f2b705; --amber-ink:#1a1400;
  --good:#4cc38a; --bad:#ef6a5a; --red:#d4302a; --red-ink:#fff;
  --display:"Barlow Condensed","Arial Narrow",sans-serif;
  --body:"Barlow","Segoe UI",system-ui,sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--body);font-size:15px;line-height:1.45}
*{box-sizing:border-box}
.app{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr);gap:12px;padding-inline:16px;padding-block:12px}
header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px}
.brand{display:flex;align-items:center;gap:10px}
.brand .mark{width:30px;height:30px;border-radius:6px;background:var(--amber);display:grid;place-items:center}
.brand h1{font-family:var(--display);font-weight:700;font-size:26px;letter-spacing:.02em;margin:0;text-transform:uppercase}
.tabs{display:flex;gap:4px;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:4px}
.tab{font:600 14px var(--body);color:var(--muted);background:none;border:0;border-radius:6px;padding:8px 14px;cursor:pointer}
.tab[aria-selected="true"]{background:var(--amber);color:var(--amber-ink)}
.tab:focus-visible,.btn:focus-visible,.opt:focus-visible,.seg-b:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
.main{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:12px;min-height:0}
#stage{position:relative;border-radius:10px;overflow:hidden;background:#1b252d;min-height:320px;border:1px solid var(--line)}
#stage canvas{display:block;width:100%;height:100%;touch-action:none}
.zoom{position:absolute;right:12px;bottom:12px;display:flex;flex-direction:column;gap:6px}
.zoom button{width:44px;height:44px;border-radius:8px;border:1px solid var(--line);background:rgba(14,19,23,.85);color:var(--fg);font:700 22px var(--body);cursor:pointer;display:grid;place-items:center}
.zoom button:hover{border-color:var(--amber)}
.zoom button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
.zoom #z-fit{font-size:11px;font-weight:600;letter-spacing:.04em}
.hint-chip{position:absolute;left:12px;top:12px;font-size:12px;color:var(--muted);background:rgba(14,19,23,.8);border:1px solid var(--line);border-radius:999px;padding:5px 10px;pointer-events:none}
.callout{position:absolute;left:50%;top:12px;transform:translateX(-50%);max-width:min(88%,420px);background:rgba(14,19,23,.92);border:1px solid var(--amber);border-radius:8px;padding:8px 12px;font-size:13px;pointer-events:none}
.callout b{color:var(--amber);font-family:var(--display);font-size:16px;letter-spacing:.03em;display:block}
/* dash knobs */
.dash{position:absolute;left:12px;bottom:12px;display:flex;gap:10px;background:rgba(14,19,23,.88);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.knob{display:grid;justify-items:center;gap:6px;width:92px;text-align:center}
.knob .cap{width:40px;height:40px;display:grid;place-items:center;transition:transform .25s,box-shadow .25s}
.knob.park .cap{background:var(--amber);transform:rotate(45deg) scale(.82);border-radius:4px}
.knob.air .cap{background:var(--red);clip-path:polygon(30% 0,70% 0,100% 30%,100% 70%,70% 100%,30% 100%,0 70%,0 30%);transform:scale(.82)}
.knob.park.out .cap{transform:rotate(45deg) scale(1);box-shadow:0 0 0 3px rgba(242,183,5,.25)}
.knob.air.out .cap{transform:scale(1)}
.knob .cap span{font:700 9px var(--body);letter-spacing:.06em;color:var(--amber-ink)}
.knob.park .cap span{transform:rotate(-45deg)}
.knob.air .cap span{color:var(--red-ink)}
.knob small{font-size:11px;line-height:1.2;color:var(--muted)}
.knob small b{display:block;color:var(--fg);font-weight:600;font-size:12px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:18px;overflow:auto;display:flex;flex-direction:column;gap:14px;min-width:0}
.eyebrow{font:600 12px var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--amber)}
.topline{display:flex;justify-content:space-between;align-items:center;gap:10px}
.timer{font:700 18px var(--display);font-variant-numeric:tabular-nums;color:var(--fg)}
.panel h2{font-family:var(--display);font-weight:700;font-size:28px;line-height:1.05;margin:0;text-wrap:balance}
.panel p{margin:0;color:var(--muted)}
.row{display:flex;flex-wrap:wrap;gap:8px}
.btn{font:600 15px var(--body);border-radius:8px;padding:10px 16px;cursor:pointer;border:1px solid var(--line);background:var(--panel2);color:var(--fg)}
.btn.primary{background:var(--amber);border-color:var(--amber);color:var(--amber-ink)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.fb{border-radius:8px;padding:12px 14px;border:1px solid var(--line);background:var(--panel2);display:flex;flex-direction:column;gap:6px}
.fb strong{font-family:var(--display);font-size:20px;letter-spacing:.02em}
.fb.good{border-color:var(--good)} .fb.good strong{color:var(--good)}
.fb.bad{border-color:var(--bad)} .fb.bad strong{color:var(--bad)}
.fb.info{border-color:var(--amber)} .fb.info strong{color:var(--amber)}
.fb p{color:var(--fg)}
.progress{display:flex;gap:3px}
.progress i{flex:1;height:5px;border-radius:3px;background:var(--line)}
.progress i.on{background:var(--amber)} .progress i.ok{background:var(--good)} .progress i.no{background:var(--bad)}
.opts{display:grid;gap:8px}
.opt{text-align:left;font:500 14px/1.35 var(--body);color:var(--fg);background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:11px 12px;cursor:pointer;display:flex;gap:10px;align-items:flex-start}
.opt:hover:not(:disabled){border-color:var(--amber)}
.opt:disabled{cursor:default;opacity:.55}
.opt.picked-bad{border-color:var(--bad);opacity:1}
.opt.picked-good{border-color:var(--good);opacity:1}
.opt .k{flex:none;width:22px;height:22px;border-radius:5px;border:1px solid var(--line);display:grid;place-items:center;font:700 12px var(--body);color:var(--muted)}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:5px;font-size:14px}
.steps li{display:flex;gap:10px;align-items:flex-start;color:var(--fg)}
.steps .n{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font:700 12px var(--body);font-variant-numeric:tabular-nums;background:var(--good);color:#06150d}
.steps li.miss .n{background:var(--bad);color:#1d0503}
.steps li span:last-child{padding-top:2px}
.seg{display:flex;gap:4px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:4px}
.seg-b{flex:1;font:600 13px var(--body);color:var(--muted);background:none;border:0;border-radius:6px;padding:8px 6px;cursor:pointer}
.seg-b[aria-selected="true"]{background:var(--fg);color:var(--bg)}
.status{display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:13px}
.status div{display:flex;justify-content:space-between;gap:6px;background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:6px 8px}
.status span{color:var(--muted)}
.status b{font-weight:600}
.status b.ok{color:var(--good)}
.sec{font:600 12px var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.big{display:flex;align-items:baseline;gap:10px;font-variant-numeric:tabular-nums}
.big b{font-family:var(--display);font-size:52px;line-height:1}
.miss-list{display:grid;gap:8px}
.miss-list div{border-left:3px solid var(--bad);padding:2px 0 2px 10px;font-size:14px}
.miss-list div p{color:var(--muted)}
.fine{font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:10px;margin-top:auto}
@media (max-width:900px){
  .app{height:auto}
  .main{grid-template-columns:1fr}
  #stage{height:56vh}
}
@media (max-width:480px){
  .knob{width:74px}
  .dash{gap:4px;padding:8px}
  .hint-chip{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<div class="app">
  <header>
    <div class="brand">
      <div class="mark" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#1a1400" stroke-width="2.2"><circle cx="10" cy="10" r="7"/><path d="M10 10V3.5M10 10l-3 4M10 10l3 4"/></svg>
      </div>
      <h1>Coupling Trainer</h1>
    </div>
    <div class="tabs" role="tablist">
      <button class="tab" id="tab-c" role="tab" aria-selected="true">Coupling</button>
      <button class="tab" id="tab-u" role="tab" aria-selected="false">Uncoupling</button>
    </div>
  </header>
  <div class="main">
    <div id="stage">
      <div class="hint-chip" id="chip">Drag to look around · + / − to zoom</div>
      <div class="callout" id="callout" hidden></div>
      <div class="dash" aria-label="Cab brake controls">
        <div class="knob park" id="k-park"><div class="cap"><span>PARK</span></div><small>Parking brake<b id="k-park-t">Released</b></small></div>
        <div class="knob air" id="k-air"><div class="cap"><span>TRAILER</span></div><small>Trailer air<b id="k-air-t">Out</b></small></div>
      </div>
      <div class="zoom">
        <button id="z-in" aria-label="Zoom in">+</button>
        <button id="z-out" aria-label="Zoom out">&minus;</button>
        <button id="z-fit" aria-label="Reset view">RESET</button>
      </div>
    </div>
    <aside class="panel" id="panel"></aside>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
(function(){
const stage=document.getElementById('stage'), panel=document.getElementById('panel'), callout=document.getElementById('callout');
const FT=0.3048, TW=102*0.0254, TOP=13.5*FT, TL=53*FT, R=0.505, WY=0.51;
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- renderer / scene ---------- */
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputEncoding=THREE.sRGBEncoding;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
stage.appendChild(renderer.domElement);
const scene=new THREE.Scene();
scene.background=new THREE.Color(0xb7c9d8);
scene.fog=new THREE.Fog(0xb7c9d8,70,190);
const camera=new THREE.PerspectiveCamera(40,1,0.05,400);
const controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.enableDamping=true; controls.maxPolarAngle=Math.PI*0.56; controls.minDistance=1.2; controls.maxDistance=70;

scene.add(new THREE.HemisphereLight(0xe6f1ff,0x50545a,0.75));
const sun=new THREE.DirectionalLight(0xfff2dd,1.45);
sun.position.set(14,30,-20); sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048); sun.shadow.bias=-0.0004;
Object.assign(sun.shadow.camera,{left:-28,right:28,top:28,bottom:-28,near:1,far:100});
sun.target.position.set(0,0,0);
scene.add(sun); scene.add(sun.target);

function asphaltTex(rx,ry){
  const c=document.createElement('canvas');c.width=c.height=256;const g=c.getContext('2d');
  g.fillStyle='#55585b';g.fillRect(0,0,256,256);
  for(let i=0;i<4500;i++){const v=66+Math.random()*44|0;g.fillStyle='rgb('+v+','+v+','+(v+2)+')';g.fillRect(Math.random()*256,Math.random()*256,2,2);}
  const t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.encoding=THREE.sRGBEncoding;t.repeat.set(rx,ry);return t;
}
const ground=new THREE.Mesh(new THREE.PlaneGeometry(400,400),new THREE.MeshStandardMaterial({color:0x8e8a7c,roughness:1}));
ground.rotation.x=-Math.PI/2; ground.receiveShadow=true; scene.add(ground);
const lot=new THREE.Mesh(new THREE.PlaneGeometry(90,44),new THREE.MeshStandardMaterial({map:asphaltTex(22,11),roughness:.95}));
lot.rotation.x=-Math.PI/2; lot.position.set(2,0.004,0); lot.receiveShadow=true; scene.add(lot);
const lineMat=new THREE.MeshBasicMaterial({color:0xe8d27a});
for(const z of[-6.6,-2.2,2.2,6.6]){const s=new THREE.Mesh(new THREE.PlaneGeometry(20,0.14),lineMat);s.rotation.x=-Math.PI/2;s.position.set(-7,0.008,z);scene.add(s);}
/* yard fence + parked trailers for context */
const fenceMat=new THREE.MeshStandardMaterial({color:0x9aa3a8,metalness:.5,roughness:.5});
for(let x=-40;x<=44;x+=3){const p=new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.04,2,6),fenceMat);p.position.set(x,1,21);scene.add(p);}
const mesh=new THREE.Mesh(new THREE.PlaneGeometry(84,1.9),new THREE.MeshBasicMaterial({color:0x9aa3a8,transparent:true,opacity:.28,side:THREE.DoubleSide}));
mesh.position.set(2,1,21);scene.add(mesh);

/* ---------- materials (from the Backup Semi Trailer truck) ---------- */
const M={
  paint:new THREE.MeshStandardMaterial({color:0x1f5fa8,metalness:0.45,roughness:0.32}),
  chrome:new THREE.MeshStandardMaterial({color:0xdde3e8,metalness:1,roughness:0.15}),
  alum:new THREE.MeshStandardMaterial({color:0xc4c9cd,metalness:0.8,roughness:0.35}),
  black:new THREE.MeshStandardMaterial({color:0x151617,roughness:0.6,metalness:0.2}),
  rubber:new THREE.MeshStandardMaterial({color:0x1a1a1a,roughness:0.95}),
  frame:new THREE.MeshStandardMaterial({color:0x222426,roughness:0.7,metalness:0.4}),
  glass:new THREE.MeshStandardMaterial({color:0x1e2a33,metalness:0.6,roughness:0.08}),
  trailer:new THREE.MeshStandardMaterial({color:0xf3f4f2,roughness:0.5,metalness:0.15}),
  amber:new THREE.MeshStandardMaterial({color:0xffa31a,roughness:0.4}),
  red:new THREE.MeshStandardMaterial({color:0xc81414,roughness:0.4}),
  head:new THREE.MeshStandardMaterial({color:0xf4f6ff,roughness:0.2,metalness:0.3}),
  tapeR:new THREE.MeshStandardMaterial({color:0xd8211d,roughness:0.3,emissive:0x3a0000}),
  tapeW:new THREE.MeshStandardMaterial({color:0xffffff,roughness:0.3,emissive:0x222222}),
  fw:new THREE.MeshStandardMaterial({color:0x2b2d30,metalness:0.55,roughness:0.28}),
  grease:new THREE.MeshStandardMaterial({color:0x2e2817,metalness:0.3,roughness:0.12}),
  handle:new THREE.MeshStandardMaterial({color:0xd92b1f,roughness:0.45}),
  chock:new THREE.MeshStandardMaterial({color:0xf2b705,roughness:0.6}),
  lineR:new THREE.MeshStandardMaterial({color:0xc81e1e,roughness:0.5}),
  lineB:new THREE.MeshStandardMaterial({color:0x1d5fd1,roughness:0.5}),
  lineG:new THREE.MeshStandardMaterial({color:0x2f8a3a,roughness:0.5}),
  glow:new THREE.MeshBasicMaterial({color:0xf2b705,transparent:true,opacity:0,depthTest:false}),
};
const postMat=new THREE.MeshStandardMaterial({color:0xd7dadb,roughness:0.45,metalness:0.4});
const doorMat=new THREE.MeshStandardMaterial({color:0xe9ebea,roughness:0.5,metalness:0.2});
const fenderMat=new THREE.MeshStandardMaterial({color:0x151617,roughness:0.6,side:THREE.DoubleSide});
const frontFender=M.paint.clone(); frontFender.side=THREE.DoubleSide;

function box(w,h,d,mat,x,y,z,parent){const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;(parent||scene).add(m);return m;}
function cyl(r,len,mat,x,y,z,axis,parent,seg){const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,len,seg||24),mat);if(axis==='x')m.rotation.z=Math.PI/2;if(axis==='z')m.rotation.x=Math.PI/2;m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;(parent||scene).add(m);return m;}

/* ---------- tires ---------- */
function tireUnit(parent,x,z,w,outer,side,spins){
  const g=new THREE.Group(); g.position.set(x,WY,z); parent.add(g);
  const spin=new THREE.Group(); g.add(spin); spins.push(spin);
  const tor=new THREE.Mesh(new THREE.TorusGeometry(0.39,0.13,14,36),M.rubber); tor.scale.z=w/0.26; tor.castShadow=true; spin.add(tor);
  const tread=new THREE.Mesh(new THREE.CylinderGeometry(R,R,w,36,1,true),M.rubber); tread.rotation.x=Math.PI/2; tread.castShadow=true; spin.add(tread);
  const rim=new THREE.Mesh(new THREE.CylinderGeometry(0.29,0.29,w-0.03,28),outer?M.alum:M.frame); rim.rotation.x=Math.PI/2; spin.add(rim);
  if(outer){
    const hub=new THREE.Mesh(new THREE.CylinderGeometry(0.11,0.13,0.14,16),M.chrome); hub.rotation.x=Math.PI/2; hub.position.z=side*(w/2+0.005); spin.add(hub);
    for(let k=0;k<10;k++){const a=k/10*Math.PI*2;const n=new THREE.Mesh(new THREE.CylinderGeometry(0.018,0.018,0.05,6),M.chrome);n.rotation.x=Math.PI/2;n.position.set(Math.cos(a)*0.2,Math.sin(a)*0.2,side*(w/2-0.005));spin.add(n);}
  }
}
function wheelSet(parent,x,side,type,spins){
  const list=type==='steer'?[[side*(TW/2-0.16),0.27,true]]:[[side*(TW/2-0.2),0.27,true],[side*(TW/2-0.5),0.27,false]];
  list.forEach(([z,w,outer])=>tireUnit(parent,x,z,w,outer,side,spins));
}

/* ---------- tractor (from 3DTruck) with a working fifth wheel ---------- */
const tSpins=[], trSpins=[];
function buildTractor(){
  const g=new THREE.Group(), sp=tSpins;
  const axles=[0.72,-0.6], rearAx=-0.6, fwX=-0.6;
  const STEER=6.6,SL0=1.95,SL1=3.85,CB1=5.7,HD1=7.95;
  const frameRear=rearAx-1.0;
  [0.43,-0.43].forEach(z=>box(HD1+0.2-frameRear,0.28,0.1,M.frame,(frameRear+HD1+0.2)/2,0.92,z,g));
  box(0.15,0.2,1.0,M.frame,frameRear+0.08,0.92,0,g);
  axles.forEach(x=>{
    cyl(0.07,2.0,M.frame,x,WY,0,'z',g,12);
    cyl(0.18,0.25,M.black,x,0.52,0,'z',g,16);
    [1,-1].forEach(s=>cyl(0.15,0.3,M.black,x+0.5,0.9,s*0.45,null,g,16));
    [1,-1].forEach(s=>wheelSet(g,x,s,'dual',sp));
    [1,-1].forEach(s=>{
      const fg=new THREE.CylinderGeometry(0.66,0.66,0.62,24,1,true,-Math.PI*0.45,Math.PI*0.9);fg.rotateX(-Math.PI/2);
      const f=new THREE.Mesh(fg,fenderMat);f.position.set(x,0.53,s*(TW/2-0.35));f.castShadow=true;g.add(f);
    });
  });
  [1,-1].forEach(s=>box(0.02,0.65,0.62,M.rubber,rearAx-0.75,0.55,s*(TW/2-0.36),g));
  [1,-1].forEach(s=>{
    const len=1.55;
    cyl(0.33,len,M.chrome,SL0+0.15+len/2,0.78,s*(TW/2-0.2),'x',g,32);
    [0.18,len-0.18].forEach(q=>cyl(0.345,0.05,M.black,SL0+0.15+q,0.78,s*(TW/2-0.2),'x',g,32));
    box(0.85,0.55,0.48,M.chrome,SL1+0.85,0.7,s*(TW/2-0.24),g);
    [0.55,0.85].forEach(y=>box(0.75,0.03,0.2,M.black,SL1+0.85,y+0.01,s*(TW/2),g));
  });
  box(SL1-SL0,2.45,TW-0.04,M.paint,(SL0+SL1)/2,1.2+1.225,0,g);
  box(SL1-SL0,0.06,TW,M.black,(SL0+SL1)/2,1.2,0,g);
  [1,-1].forEach(s=>{
    box(0.55,0.32,0.02,M.glass,SL0+1.1,2.7,s*(TW/2-0.01),g);
    for(let i=0;i<3;i++)box(0.4,0.03,0.015,M.black,SL0+0.5,1.6+i*0.06,s*(TW/2-0.015),g);
    box(0.5,2.1,0.03,M.paint,SL0-0.22,2.45,s*(TW/2-0.03),g);
  });
  box(1.4,0.55,TW-0.06,M.paint,SL1+0.1,3.68,0,g);
  /* catwalk deck + line hanger behind the sleeper */
  box(0.5,0.05,1.3,M.alum,SL0-0.25,1.18,0,g);
  box(0.06,1.2,0.9,M.frame,SL0-0.1,1.85,-0.05,g);
  const cabH=2.1;
  box(CB1-SL1,cabH,TW-0.02,M.paint,(SL1+CB1)/2,1.2+cabH/2,0,g);
  box(CB1-SL1-0.2,0.25,TW-0.06,M.paint,(SL1+CB1)/2-0.1,1.2+cabH+0.12,0,g);
