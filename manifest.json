  const crank=new THREE.Group(); crank.position.set(LX,0.95,1.02); g.add(crank);
  cyl(0.022,0.25,M.frame,0,0,0.04,'z',crank,8);
  box(0.03,0.32,0.03,M.frame,0,-0.15,0.17,crank);
  cyl(0.025,0.14,M.handle,0,-0.3,0.24,'z',crank,8);
  return {g,legs,crank,kp,LX,rear,ax};
}

const rig=new THREE.Group(); scene.add(rig);
const T=buildTractor(); rig.add(T.g);
const L=buildTrailer(); rig.add(L.g);

/* chocks */
function chockGeo(){
  const s=new THREE.Shape(); s.moveTo(0,0); s.lineTo(0.34,0); s.lineTo(0.06,0.24); s.lineTo(0,0.24); s.lineTo(0,0);
  const g=new THREE.ExtrudeGeometry(s,{depth:0.26,bevelEnabled:false}); g.translate(0,0,-0.13); return g;
}
const chocks=[]; const cg=chockGeo();
[[L.ax[1]+0.55,-1],[L.ax[0]-0.55,1]].forEach(([x,dir])=>[1,-1].forEach(s=>{
  const c=new THREE.Mesh(cg,M.chock); c.castShadow=true;
  c.rotation.y=dir>0?0:Math.PI; c.userData={x:x+dir*0.0,z:s*(TW/2-0.2),s};
  if(dir<0) c.userData.x=x;
  rig.add(c); chocks.push(c);
}));

/* air lines + light cord */
const LINES=[
  {mat:M.lineR,a:new THREE.Vector3(1.88,2.3,-0.38),b:new THREE.Vector3(0.95,1.58,-0.85),key:'lines'},
  {mat:M.lineB,a:new THREE.Vector3(1.88,2.3,-0.22),b:new THREE.Vector3(0.95,1.58,-0.62),key:'lines'},
  {mat:M.lineG,a:new THREE.Vector3(1.88,2.3,0.12),b:new THREE.Vector3(0.96,1.76,0.0),key:'elec'},
];
LINES.forEach(l=>{
  l.coil=new THREE.Group();
  for(let i=0;i<5;i++){const t=new THREE.Mesh(new THREE.TorusGeometry(0.09,0.016,6,18),l.mat);t.rotation.y=Math.PI/2;t.position.set(0,-0.1-i*0.06,0);l.coil.add(t);}
  T.g.add(l.coil); l.coil.position.copy(l.a).add(new THREE.Vector3(0.02,0,0));
  l.mesh=new THREE.Mesh(new THREE.BufferGeometry(),l.mat); l.mesh.castShadow=true; rig.add(l.mesh); l.sig='';
});
function updateLines(){
  LINES.forEach(l=>{
    const p=S[l.key];
    l.coil.visible=p<0.02;
    l.mesh.visible=p>0.02;
    if(!l.mesh.visible) return;
    const sig=S.tx.toFixed(3);
    if(sig!==l.sig){
      l.sig=sig;
      const A=l.a.clone(); A.x+=S.tx; const B=l.b.clone();
      const d=A.distanceTo(B);
      const pts=[A,A.clone().add(new THREE.Vector3(-0.15,-0.25,0)),
        new THREE.Vector3((A.x+B.x)/2,Math.min(A.y,B.y)-0.12-d*0.06,(A.z+B.z)/2),
        B.clone().add(new THREE.Vector3(0.18,0.02,0)),B];
      l.mesh.geometry.dispose();
      l.mesh.geometry=new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),48,0.02,6,false);
    }
    const n=l.mesh.geometry.index.count;
    l.mesh.geometry.setDrawRange(0,Math.floor(p*n/6)*6);
  });
}

/* glow rings for inspections */
const glowKP=new THREE.Mesh(new THREE.TorusGeometry(0.22,0.025,8,40),M.glow.clone());
glowKP.rotation.x=Math.PI/2; glowKP.position.set(0,1.12,0); glowKP.renderOrder=5; rig.add(glowKP);
const glowLeg=[1,-1].map(s=>{const m=new THREE.Mesh(new THREE.TorusGeometry(0.2,0.025,8,40),M.glow.clone());m.rotation.x=Math.PI/2;m.position.set(L.LX,0.15,s*0.85);m.renderOrder=5;rig.add(m);return m;});
const glowFW=new THREE.Mesh(new THREE.TorusGeometry(0.62,0.025,8,48),M.glow.clone());
glowFW.rotation.x=Math.PI/2; glowFW.renderOrder=5; rig.add(glowFW);
const glows=[glowKP,...glowLeg,glowFW];

/* ---------- rig state ---------- */
const S={};
function setState(o){Object.assign(S,{rigX:0,tx:16,tz:2.4,yaw:0.12,trY:0.05,tilt:0.12,handle:0,chocks:0,lines:0,elec:0,legLift:0,crank:0,tug:0,park:false,air:'out',glow:0,glowWhich:null},o);lastTx=S.tx;lastRig=S.rigX;}
let lastTx=0,lastRig=0;
function applyState(){
  rig.position.x=S.rigX;
  T.g.position.set(S.tx+S.tug,0,S.tz); T.g.rotation.y=S.yaw;
  L.g.position.set(S.tug*0.4,S.trY,0);
  T.tilt.rotation.z=S.tilt;
  T.handle.position.z=-0.62-0.22*S.handle;
  T.jaws.children.forEach(j=>j.position.z=j.userData.s*(0.09+0.06*S.handle));
  L.legs.position.y=0.5*S.legLift-S.trY;
  L.crank.rotation.z=S.crank;
  chocks.forEach(c=>{
    const u=c.userData; c.visible=S.chocks>0.01;
    c.position.set(u.x,0,u.z+u.s*(1-S.chocks)*1.6);
  });
  const dT=(S.tx-lastTx)+(S.rigX-lastRig), dR=S.rigX-lastRig;
  if(dT) tSpins.forEach(s=>s.rotation.z-=dT/R);
  if(dR) trSpins.forEach(s=>s.rotation.z-=dR/R);
  lastTx=S.tx; lastRig=S.rigX;
  glowFW.position.set(S.tx-0.6,1.26,0);
  glows.forEach(g=>g.material.opacity=0);
  if(S.glowWhich){const pulse=S.glow*(0.55+0.45*Math.sin(performance.now()/160));S.glowWhich.forEach(g=>g.material.opacity=pulse);}
  updateLines();
  const kp=document.getElementById('k-park'),ka=document.getElementById('k-air');
  kp.classList.toggle('out',S.park); document.getElementById('k-park-t').textContent=S.park?'Pulled out (set)':'Pushed in';
  ka.classList.toggle('out',S.air==='out'); document.getElementById('k-air-t').textContent=S.air==='out'?'Pulled out':'Pushed in (air on)';
}

/* ---------- tweens ---------- */
const tweens=[];
function tween(dur,fn){if(RM)dur*=0.35;return new Promise(res=>tweens.push({t0:null,dur:Math.max(1,dur),fn,res}));}
const ease=p=>p<.5?2*p*p:1-Math.pow(-2*p+2,2)/2;
function to(vals,dur,e){let from=null;return tween(dur,p=>{if(!from){from={};for(const k in vals)from[k]=S[k];}const q=(e||ease)(p);for(const k in vals)S[k]=from[k]+(vals[k]-from[k])*q;});}
const wait=ms=>tween(ms,()=>{});
function runTweens(now){
  for(let i=tweens.length-1;i>=0;i--){const t=tweens[i];if(t.t0===null)t.t0=now;const p=Math.min(1,(now-t.t0)/t.dur);t.fn(p);if(p>=1){tweens.splice(i,1);t.res();}}
}

/* ---------- camera ---------- */
let camAnim=null;
function camTo(pos,tgt,dur){camAnim={t0:null,dur:RM?1:(dur||1100),p0:camera.position.clone(),t0v:controls.target.clone(),p1:new THREE.Vector3(...pos),t1:new THREE.Vector3(...tgt)};}
controls.addEventListener('start',()=>{camAnim=null;});
function runCam(now){
  if(!camAnim) return;
  if(camAnim.t0===null)camAnim.t0=now;
  const p=ease(Math.min(1,(now-camAnim.t0)/camAnim.dur));
  camera.position.lerpVectors(camAnim.p0,camAnim.p1,p);
  controls.target.lerpVectors(camAnim.t0v,camAnim.t1,p);
  if(p>=1)camAnim=null;
}
const VIEW={
  over:()=>{const a=S.rigX+L.rear-0.3,b=S.rigX+S.tx+8.4,c=(a+b)/2,sp=(b-a)*Math.max(1,1.45/camera.aspect);return [[c+sp*0.06,sp*0.38,-sp*0.98],[c,0.6,0]];},
  fw:()=>[[S.rigX+S.tx-2.6,3.0,-3.4],[S.rigX+S.tx-0.6,1.2,0]],
  chocks:()=>[[S.rigX+L.rear+8.5,2.4,-6],[S.rigX+L.rear+2.6,0.4,0]],
  behind:()=>[[S.rigX+S.tx+3,4.2,-9],[S.rigX+S.tx+1,1.4,0]],
  contact:()=>[[S.rigX+1.5,1.5,-4.6],[S.rigX+0.9,1.25,0]],
  lines:()=>[[S.rigX+S.tx+3.6,3.4,-4.4],[S.rigX+(S.tx+1.9+0.9)/2,1.9,-0.3]],
  cab:()=>[[S.rigX+S.tx+10,4.2,-8],[S.rigX+S.tx+3.5,2,0]],
  under:()=>[[S.rigX-2.7,1.11,-0.3],[S.rigX+0.1,1.18,0]],
  gear:()=>[[S.rigX+L.LX+3.2,1.5,4.6],[S.rigX+L.LX,0.55,0.5]],
  wide:()=>VIEW.over(),
};
function view(k){const v=VIEW[k]();camTo(v[0],v[1]);}

/* ---------- sound ---------- */
let AC=null;
function ac(){try{if(!AC)AC=new (window.AudioContext||window.webkitAudioContext)();if(AC.state==='suspended')AC.resume();}catch(e){AC=null;}return AC;}
function noise(dur,freq,q,vol){
  const a=ac(); if(!a) return;
  const b=a.createBuffer(1,a.sampleRate*dur,a.sampleRate),d=b.getChannelData(0);
  for(let i=0;i<d.length;i++)d[i]=(Math.random()*2-1);
  const src=a.createBufferSource();src.buffer=b;
  const f=a.createBiquadFilter();f.type='bandpass';f.frequency.value=freq;f.Q.value=q;
  const g=a.createGain();g.gain.setValueAtTime(vol,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+dur);
  src.connect(f);f.connect(g);g.connect(a.destination);src.start();
}
function thunk(){const a=ac();if(!a)return;const o=a.createOscillator(),g=a.createGain();o.frequency.setValueAtTime(140,a.currentTime);o.frequency.exponentialRampToValueAtTime(45,a.currentTime+0.18);g.gain.setValueAtTime(0.5,a.currentTime);g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+0.25);o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+0.3);noise(0.08,900,1,0.25);}
const hiss=()=>noise(0.9,3500,0.7,0.12);
const click=()=>noise(0.05,1800,2,0.2);

/* ---------- procedures ---------- */
const CRANK=Math.PI*10;
const PROC={
  c:{
    name:'Coupling',verb:'Coupled',
    start:{rigX:0,tx:16,tz:2.4,yaw:0.12,trY:0.05,tilt:0.12,handle:0,chocks:0,lines:0,elec:0,legLift:0,park:false,air:'out'},
    startView:'over',
    steps:[
      {t:'Inspect the fifth wheel',why:'Look for damaged or missing parts. It should be greased, the jaws open, the release handle in the unlocked position, and the plate tilted down toward the rear of the tractor.',hint:'Before the tractor goes near the trailer, check the coupling device itself.',
       go:async()=>{view('fw');S.glowWhich=[glowFW];await to({glow:1},500);click();await to({handle:1},700);await wait(700);await to({glow:0},400);S.glowWhich=null;}},
      {t:'Inspect the area and chock the trailer wheels',why:'Check for people, obstacles and soft ground around the trailer. Chocks keep the trailer from rolling if its spring brakes aren’t set.',hint:'The trailer needs to stay put before you back toward it.',
       go:async()=>{view('chocks');await wait(500);await to({chocks:1},1100);}},
      {t:'Line up the tractor directly in front of the trailer',why:'Get the tractor straight in front of the trailer. Never back under at an angle: it can push the trailer sideways and break the landing gear.',hint:'Get square to the trailer before backing.',
       go:async()=>{view('over');await to({tx:6,tz:0,yaw:0},2000);}},
      {t:'Back slowly until the fifth wheel just touches the trailer',why:'Stop as soon as the fifth wheel touches the trailer. Don’t back under yet.',hint:'Close the gap, but don’t back under yet.',
       go:async()=>{view('contact');await to({tx:2.05},1800);thunk();}},
      {t:'Secure the tractor',why:'Set the parking brake and put the transmission in neutral before you climb out.',hint:'You’re about to leave the cab.',
       go:async()=>{view('cab');await wait(500);click();S.park=true;await wait(500);}},
      {t:'Check the trailer height',why:'The trailer should sit low enough that the fifth wheel lifts it slightly as you back under. Too high and the kingpin can ride over the jaws (a high hook). Crank the landing gear to adjust, and check the kingpin lines up with the throat.',hint:'Look at how the trailer nose sits compared to the fifth wheel.',
       go:async()=>{view('contact');await to({trY:-0.03,crank:S.crank+CRANK},1800);}},
      {t:'Connect the air lines to the trailer',why:'Emergency (red) to emergency, service (blue) to service. Check the glad hand seals, and support the lines so they won’t get crushed or snagged while you back under.',hint:'The trailer brakes need a connection to the tractor.',
       go:async()=>{view('lines');await wait(400);click();await to({lines:1},1500);click();}},
      {t:'Supply air to the trailer',why:'Push in the red trailer air supply knob and wait for normal pressure. Check for crossed lines: apply and release the trailer brakes and listen for them to work.',hint:'Lines are on. Now charge the trailer system.',
       go:async()=>{view('cab');await wait(500);click();S.air='in';hiss();await wait(900);}},
      {t:'Lock the trailer brakes',why:'Pull the trailer air supply knob back out. The trailer’s spring brakes set, so the trailer won’t roll away as you back under it.',hint:'The trailer must not move when the tractor pushes on it.',
       go:async()=>{await wait(200);click();S.air='out';hiss();await wait(700);}},
      {t:'Back under the trailer slowly until the fifth wheel locks',why:'Use the lowest reverse gear and back slowly until the tractor stops. Don’t hit the kingpin hard.',hint:'Everything is ready for the hook-up itself.',
       go:async()=>{view('contact');S.park=false;click();
         await to({tx:1.35,tilt:0.03},1300,p=>p);await to({tx:0.6,tilt:0,trY:0},1500,p=>1-(1-p)*(1-p));thunk();await to({handle:0},180);}},
      {t:'Do a tug test',why:'With the trailer brakes still locked, pull gently forward in low gear. The trailer shouldn’t come off the fifth wheel. Do it twice.',hint:'Prove the jaws are holding before you trust them.',
       go:async()=>{view('behind');await wait(400);for(let i=0;i<2;i++){await to({tug:0.07},260);await to({tug:0},300);await wait(250);}}},
      {t:'Secure the vehicle',why:'Neutral, parking brake set, engine off and the key in your pocket so nobody moves the truck while you’re under it.',hint:'You’re about to get out and go under the trailer.',
       go:async()=>{view('cab');await wait(400);click();S.park=true;await wait(500);}},
      {t:'Inspect the coupling',why:'Use a flashlight. No gap between the upper and lower fifth wheel, the jaws closed around the kingpin shank (not the head), and the release handle in the locked position with the safety latch over it.',hint:'Go look at the connection with your own eyes.',
       go:async()=>{view('under');showCallout('Look for','No gap between plates · Jaws on the shank · Handle locked');S.glowWhich=[glowKP];await to({glow:1},500);await wait(1800);await to({glow:0},400);S.glowWhich=null;hideCallout();}},
      {t:'Connect the light cord and check the air lines',why:'Plug in the electrical cord and lock it. Make sure the air and electrical lines aren’t damaged and won’t rub on moving parts.',hint:'The trailer still has no lights.',
       go:async()=>{view('lines');await wait(400);click();await to({elec:1},1300);click();}},
      {t:'Raise the landing gear and stow the crank handle',why:'Start in low gear and switch to high once the weight’s off. Raise it all the way up and secure the crank handle.',hint:'The trailer is on the fifth wheel now. Get its supports off the ground.',
       go:async()=>{view('gear');await wait(500);await to({legLift:1,crank:S.crank+CRANK*1.6},2200);}},
      {t:'Remove the wheel chocks',why:'Pull the chocks and store them. Then finish your pre-trip and air brake checks before you drive away.',hint:'One thing is still holding the trailer wheels.',
       go:async()=>{view('chocks');await wait(400);await to({chocks:0},1000);}},
    ],
    decoys:[
      {t:'Back under quickly so the jaws snap shut',why:'Never back under hard. A hard hit can damage the kingpin, fifth wheel or landing gear, and can shove the trailer. Always back slowly.'},
      {t:'Skip the tug test if you heard the jaws lock',why:'The sound isn’t proof. A high hook or jaws closed on the kingpin head can sound locked. Always tug test and look.'},
      {t:'Release the trailer brakes so it rolls back onto the fifth wheel',why:'The trailer brakes stay locked while you back under. A rolling trailer can come off its landing gear.'},
    ],
  },
  u:{
    name:'Uncoupling',verb:'Uncoupled',
    start:{rigX:-9,tx:0.6,tz:0,yaw:0,trY:0,tilt:0,handle:0,chocks:0,lines:1,elec:1,legLift:1,park:false,air:'in'},
    startView:'wide',
    steps:[
      {t:'Position the rig',why:'Stop on level, firm ground that will hold the trailer, in a straight line with the parking spot.',hint:'Pick the right spot first.',
       go:async()=>{view('over');await to({rigX:0},2200);}},
      {t:'Ease pressure on the locking jaws',why:'Pull the trailer air supply knob to lock the trailer brakes, back up gently to take pressure off the jaws, and set the parking brake while the tractor is pushing against the kingpin.',hint:'Make the jaws easy to release later.',
       go:async()=>{view('cab');await wait(400);click();S.air='out';hiss();await wait(600);await to({tx:0.56},600);click();S.park=true;await wait(400);}},
      {t:'Chock the trailer wheels',why:'Chock the trailer so it can’t roll once it’s off the tractor.',hint:'The trailer is about to be on its own.',
       go:async()=>{view('chocks');await wait(400);await to({chocks:1},1100);}},
      {t:'Lower the landing gear',why:'Crank it down until it makes firm contact with the ground. On a loaded trailer, give it a few more turns in low gear to take some weight off the tractor. Don’t lift the trailer off the fifth wheel.',hint:'Something has to hold up the front of the trailer.',
       go:async()=>{view('gear');await wait(400);await to({legLift:0,crank:S.crank-CRANK*1.6},2200);}},
      {t:'Disconnect the air lines and light cord',why:'Hook the glad hands to their dummy couplers or hangers, and hang the light cord plug-down so water can’t get in.',hint:'The tractor and trailer are still joined by more than the kingpin.',
       go:async()=>{view('lines');await wait(400);click();await to({lines:0,elec:0},1300);}},
      {t:'Unlock the fifth wheel',why:'Pull the release handle to the unlocked position. Keep your legs and feet clear of the rear tractor wheels.',hint:'Now free the kingpin.',
       go:async()=>{view('fw');await wait(400);click();await to({handle:1},700);await wait(300);}},
      {t:'Pull the tractor partly clear',why:'Pull forward until the fifth wheel comes out from under the trailer, then stop with the tractor frame still under the trailer. If the landing gear gives way, the trailer lands on the frame.',hint:'Ease out, but not all the way.',
       go:async()=>{view('contact');S.park=false;click();await to({tx:2.25,tilt:0.12},2000);}},
      {t:'Secure the tractor',why:'Set the parking brake and put the transmission in neutral before you get out.',hint:'You’re about to get out and look.',
       go:async()=>{view('cab');await wait(400);click();S.park=true;await wait(400);}},
      {t:'Inspect the trailer supports',why:'Make sure the ground is holding the trailer and the landing gear isn’t damaged or sinking.',hint:'Check what’s holding the trailer up.',
       go:async()=>{view('gear');S.glowWhich=glowLeg;await to({glow:1},500);await wait(1500);await to({glow:0},400);S.glowWhich=null;}},
      {t:'Pull the tractor clear',why:'Release the parking brake, check around the rig, and drive clear of the trailer.',hint:'Last move.',
       go:async()=>{view('wide');S.park=false;click();await to({tx:15},2400);}},
    ],
    decoys:[
      {t:'Pull straight out from under the trailer in one move',why:'Stop partway with the tractor frame still under the trailer. If the landing gear fails, the trailer drops onto the frame instead of the ground.'},
      {t:'Leave the air lines hooked up and pull away',why:'Pulling away with the lines connected tears off the glad hands and lines. Disconnect them before you unlock the fifth wheel.'},
      {t:'Lower the landing gear after the tractor is out',why:'The landing gear has to be down before the tractor leaves, or the trailer nose falls to the ground.'},
    ],
  },
};

/* ---------- training state ---------- */
const G={mode:'c',test:false,idx:0,opts:[],picked:null,fb:null,busy:false,missed:[],firstTry:true,wrongs:0,t0:0,t1:0,done:false,log:[]};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]];}return a;};
function best(k,v){try{const key='couplingTrainer.best.'+k;if(v!==undefined){localStorage.setItem(key,String(v));return v;}const r=localStorage.getItem(key);return r===null?null:+r;}catch(e){return null;}}

function makeOpts(){
  const P=PROC[G.mode], cur=P.steps[G.idx];
  const future=P.steps.slice(G.idx+1).map((s,i)=>({t:s.t,kind:'future',n:G.idx+2+i}));
  const near=shuffle(future.slice(0,5)), far=shuffle(future.slice(5));
  let pool=near.concat(far).slice(0,3);
  const decoys=shuffle(P.decoys.map(d=>({t:d.t,why:d.why,kind:'decoy'})));
  if(pool.length===3&&Math.random()<0.35) pool[2]=decoys.shift();
  while(pool.length<3&&decoys.length) pool.push(decoys.shift());
  G.opts=shuffle([{t:cur.t,kind:'right'}].concat(pool));
}
function reset(){
  const P=PROC[G.mode];
  tweens.length=0;
  setState(P.start); applyState();
  view(P.startView);
  Object.assign(G,{idx:0,picked:null,fb:null,busy:false,missed:[],firstTry:true,wrongs:0,t0:performance.now(),t1:0,done:false,log:[]});
  hideCallout();
  makeOpts(); render();
}
async function pick(i){
  if(G.busy||G.done) return;
  ac();
  const P=PROC[G.mode], cur=P.steps[G.idx], o=G.opts[i];
  if(o.kind==='right'){
    G.picked=i; G.busy=true;
    G.log.push({t:cur.t,ok:G.firstTry});
    G.fb={cls:'good',title:G.firstTry?'Correct':'That’s it',body:cur.why};
    render();
    await cur.go();
    G.busy=false; G.idx++; G.picked=null; G.firstTry=true; G.wrongs=0;
    if(G.idx>=P.steps.length){finish();return;}
    makeOpts(); render();
    return;
  }
  /* wrong */
  if(G.firstTry) G.missed.push({step:G.idx,t:cur.t,picked:o.t,why:o.kind==='decoy'?o.why:'“'+o.t+'” is step '+o.n+'. '+cur.why});
  G.firstTry=false; G.wrongs++;
  const body=o.kind==='decoy'?o.why:'That’s step '+o.n+' in the sequence. '+(G.wrongs>=2||G.test?'':cur.hint);
  if(G.test){
    /* test: mark it, show the right answer, carry on */
    G.picked=i; G.fb={cls:'bad',title:o.kind==='decoy'?'Unsafe':'Out of order',body:body+' The next step is: '+cur.t+'.'};
    G.opts.forEach(x=>x.lock=true); render();
    G.busy=true;
    await wait(RM?300:900);
    G.busy=false;
    G.fb.cont=true; render();
    return;
  }
  o.bad=true;
  G.fb={cls:'bad',title:o.kind==='decoy'?'Unsafe':'Not yet',body:G.wrongs>=2?body+' Hint: '+cur.hint:body};
  render();
}
async function cont(){
  const P=PROC[G.mode], cur=P.steps[G.idx];
  G.log.push({t:cur.t,ok:false});
  G.busy=true; G.fb={cls:'info',title:'Next step',body:cur.why}; G.opts.forEach(x=>x.lock=true); render();
  await cur.go();
  G.busy=false; G.idx++; G.picked=null; G.firstTry=true; G.wrongs=0;
  if(G.idx>=P.steps.length){finish();return;}
  makeOpts(); render();
}
function finish(){
  G.done=true; G.t1=performance.now(); view('over');
  const P=PROC[G.mode], score=P.steps.length-G.missed.length;
  if(G.test){const b=best(G.mode);if(b===null||score>b)best(G.mode,score);}
  render();
}
const fmt=ms=>{const s=Math.floor(ms/1000);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0');};

function statusHTML(){
  const it=[
    ['Chocks',S.chocks>0.5?'In place':'None',S.chocks>0.5],
    ['Jaws',S.handle>0.5?'Open':'Locked',S.handle<0.5&&S.tx<0.7],
    ['Air lines',S.lines>0.5?'Connected':'Off',S.lines>0.5],
    ['Light cord',S.elec>0.5?'Connected':'Off',S.elec>0.5],
    ['Landing gear',S.legLift>0.5?'Up':'Down',null],
    ['Trailer',S.tx<0.7?'On fifth wheel':'Off tractor',S.tx<0.7],
  ];
  return '<div class="status">'+it.map(([k,v,ok])=>'<div><span>'+k+'</span><b class="'+(ok?'ok':'')+'">'+v+'</b></div>').join('')+'</div>';
}
function render(){
  const P=PROC[G.mode], n=P.steps.length;
  document.getElementById('tab-c').setAttribute('aria-selected',G.mode==='c');
  document.getElementById('tab-u').setAttribute('aria-selected',G.mode==='u');
  const seg='<div class="seg" role="tablist" aria-label="Mode"><button class="seg-b" id="m-p" role="tab" aria-selected="'+!G.test+'">Practice</button><button class="seg-b" id="m-t" role="tab" aria-selected="'+G.test+'">Test</button></div>';
  if(G.done){
    const score=n-G.missed.length, b=best(G.mode);
    panel.innerHTML=seg+
      '<div class="eyebrow">'+P.name+' complete</div>'+
      '<h2>'+(G.missed.length===0?'Clean '+P.name.toLowerCase()+'. Every step in order.':P.verb+', with '+G.missed.length+' step'+(G.missed.length>1?'s':'')+' to review')+'</h2>'+
      '<div class="big"><b>'+score+'/'+n+'</b><span>right on the first try'+(G.test?' · '+fmt(G.t1-G.t0):'')+'</span></div>'+
      (G.test&&b!==null?'<p>Best test score: '+b+'/'+n+'</p>':'')+
      (G.missed.length?'<div class="sec">Review</div><div class="miss-list">'+G.missed.map(m=>'<div><b>Step '+(m.step+1)+': '+esc(m.t)+'</b><p>You picked “'+esc(m.picked)+'”.</p></div>').join('')+'</div>':'')+
      '<div class="row"><button class="btn primary" id="again">Run it again</button><button class="btn" id="other">Try '+(G.mode==='c'?'Uncoupling':'Coupling')+'</button></div>'+
      '<div class="sec">Full sequence</div><ol class="steps">'+P.steps.map((s,i)=>'<li class="'+(G.missed.some(m=>m.step===i)?'miss':'')+'"><span class="n">'+(i+1)+'</span><span>'+esc(s.t)+'</span></li>').join('')+'</ol>'+
      '<p class="fine">Follows the standard sequence in commercial driver manuals. Your trainer or company may add steps of their own.</p>';
    wire(); return;
  }
  const prog=P.steps.map((_,i)=>{const l=G.log[i];return '<i class="'+(l?(l.ok?'ok':'no'):i===G.idx?'on':'')+'"></i>';}).join('');
  const optsHTML=G.opts.map((o,i)=>{
    let cls='opt';if(o.bad)cls+=' picked-bad';if(G.picked===i)cls+=(o.kind==='right'?' picked-good':' picked-bad');
    const dis=G.busy||o.bad||o.lock;
    return '<button class="'+cls+'" data-i="'+i+'"'+(dis?' disabled':'')+'><span class="k">'+'ABCD'[i]+'</span><span>'+esc(o.t)+'</span></button>';
  }).join('');
  const fb=G.fb?'<div class="fb '+G.fb.cls+'"><strong>'+esc(G.fb.title)+'</strong><p>'+esc(G.fb.body)+'</p>'+(G.fb.cont?'<div class="row"><button class="btn primary" id="cont">Show next step</button></div>':'')+'</div>':'';
  const doneList=G.log.length?'<div class="sec">Done so far</div><ol class="steps">'+G.log.map((l,i)=>'<li class="'+(l.ok?'':'miss')+'"><span class="n">'+(i+1)+'</span><span>'+esc(l.t)+'</span></li>').join('')+'</ol>':'';
  panel.innerHTML=seg+
    '<div class="progress">'+prog+'</div>'+
    '<div class="topline"><div class="eyebrow">'+P.name+' · Step '+Math.min(G.idx+1,n)+' of '+n+'</div>'+(G.test?'<div class="timer" id="timer">'+fmt(performance.now()-G.t0)+'</div>':'')+'</div>'+
    '<h2>What’s next?</h2>'+
    (G.idx===0&&!G.fb?'<p>'+(G.mode==='c'?'You’ve pulled into the yard to hook up to this 53 ft van. Pick each step in the right order.':'You’re dropping this trailer in the yard. Pick each step in the right order.')+(G.test?' Wrong picks count against you.':'')+'</p>':'')+
    '<div class="opts">'+optsHTML+'</div>'+fb+
    '<div class="sec">Rig status</div>'+statusHTML()+
    doneList+
    '<div class="row"><button class="btn" id="restart">Restart</button></div>'+
    '<p class="fine">Follows the standard sequence in commercial driver manuals. Your trainer or company may add steps of their own.</p>';
  wire();
}
function wire(){
  panel.querySelectorAll('.opt').forEach(b=>b.onclick=()=>pick(+b.dataset.i));
  const on=(id,f)=>{const e=document.getElementById(id);if(e)e.onclick=f;};
  on('cont',cont); on('restart',reset); on('again',reset);
  on('other',()=>{G.mode=G.mode==='c'?'u':'c';reset();});
  on('m-p',()=>{if(G.test){G.test=false;reset();}});
  on('m-t',()=>{if(!G.test){G.test=true;reset();}});
}
document.getElementById('tab-c').onclick=()=>{if(G.mode!=='c'){G.mode='c';reset();}};
document.getElementById('tab-u').onclick=()=>{if(G.mode!=='u'){G.mode='u';reset();}};
addEventListener('keydown',e=>{if(e.target.closest&&e.target.closest('input,textarea'))return;const k='abcd1234'.indexOf(e.key.toLowerCase());if(k>=0&&!G.done){const i=k%4;if(G.opts[i]&&!G.opts[i].bad&&!G.opts[i].lock)pick(i);}});

function showCallout(h,t){callout.innerHTML='<b>'+esc(h)+'</b>'+esc(t);callout.hidden=false;}
function hideCallout(){callout.hidden=true;}

/* zoom */
function zoom(f){camAnim=null;const d=camera.position.clone().sub(controls.target);const len=THREE.MathUtils.clamp(d.length()*f,controls.minDistance,controls.maxDistance);camera.position.copy(controls.target).add(d.setLength(len));}
document.getElementById('z-in').onclick=()=>zoom(0.8);
document.getElementById('z-out').onclick=()=>zoom(1.25);
document.getElementById('z-fit').onclick=()=>view('over');

/* ---------- loop ---------- */
function resize(){const w=stage.clientWidth,h=stage.clientHeight;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}
new ResizeObserver(resize).observe(stage);
let lastTimer=0;
function loop(now){
  runTweens(now); runCam(now); applyState();
  controls.update();
  if(camera.position.y<0.25)camera.position.y=0.25;
  if(G.test&&!G.done&&now-lastTimer>500){lastTimer=now;const t=document.getElementById('timer');if(t)t.textContent=fmt(now-G.t0);}
  renderer.render(scene,camera);
  requestAnimationFrame(loop);
}
resize(); reset();
const v=VIEW.over(); camera.position.set(...v[0]); controls.target.set(...v[1]); camAnim=null;
requestAnimationF{
  "name": "Coupling & Uncoupling Trainer",
  "short_name": "Coupling",
  "description": "Practice the tractor-trailer coupling and uncoupling sequence step by step in 3D, with a timed test mode.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0e1317",
  "theme_color": "#0e1317",
  "categories": ["education", "simulation", "games"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "screenshots": [
    {"src": "screenshots/screenshot1.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Pick the first coupling step in the truck yard"},
    {"src": "screenshots/screenshot2.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Line up the tractor in front of the trailer"},
    {"src": "screenshots/screenshot3.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Back under the trailer with the air lines connected"},
    {"src": "screenshots/screenshot4.png", "sizes": "1920x1080", "type": "image/png", "form_factor": "wide", "label": "Inspect the coupling for a gap and locked jaws"}
  ]
}rame(loop);
window.__t={S,G,PROC,pick,reset,view,camera,controls};
})();
</script>
</body>
</html>